# Local-only server. No installation dependencies required.
PORT=4317
# Optional: Chat Completions compatible provider with image + JSON mode support.
# Both key and model must be explicitly configured. Keys stay on the server.
REDPILOT_AI_BASE_URL=https://api.openai.com/v1
REDPILOT_AI_KEY=
REDPILOT_AI_MODEL=
# Optional: Images API for generation and reference-image editing, configured separately.
# OPENAI_API_KEY is accepted only as a fallback; REDPILOT_AI_KEY is never reused here.
REDPILOT_IMAGE_API_KEY=
REDPILOT_IMAGE_BASE_URL=https://api.openai.com/v1
REDPILOT_IMAGE_MODEL=gpt-image-2.5-sunburst
# Optional: publishing bridge implementing docs/publishing-bridge.md.
# It must support durable idempotency, verification and the selected XHS account.
REDPILOT_PUBLISH_URL=
REDPILOT_PUBLISH_TOKEN=
# Enable only after the bridge's native text-cover workflow has been implemented and verified.
REDPILOT_PUBLISH_TEXT_ENABLED=false
# Legacy only: applied to the default official account on first data migration.
# Configure each additional account in the account management page.
REDPILOT_ACCOUNT_ID=

# Optional path to Python with cadquery, vtk and numpy for STEP product rendering.
REDPILOT_PYTHON=
